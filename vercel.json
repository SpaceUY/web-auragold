{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/categorias/:slug*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/autores",
      "destination": "/blog",
      "permanent": true
    }
  ]
}
