---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import { authors } from "../../data/authors";

// Slug <-> etiqueta de categoría. Slugs = los que usaba el sitio original en /categorias/*.
const CATEGORY_SLUGS: Record<string, string> = {
  Educación: "educacion",
  Guías: "guias",
  Mercado: "mercado",
  Seguridad: "seguridad",
};

const CATEGORY_INTRO: Record<string, string> = {
  Educación:
    "Los fundamentos del oro: cómo protege tu dinero frente a la inflación y cómo se compara con otros activos.",
  Guías: "Tutoriales paso a paso para invertir en oro en México, con consejos prácticos para ahorrar.",
  Mercado: "Análisis del precio del oro y por qué sigue siendo el principal refugio de valor en tiempos de crisis.",
  Seguridad: "Custodia segura, certificaciones internacionales y cómo evitar errores comunes al comprar oro.",
};

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const slugFor: Record<string, string> = {
    Educación: "educacion",
    Guías: "guias",
    Mercado: "mercado",
    Seguridad: "seguridad",
  };
  // Solo generamos páginas de categorías que tienen al menos un post (evita contenido vacío).
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return categories.map((category) => ({
    params: { categoria: slugFor[category] },
    props: { category },
  }));
}

const { category } = Astro.props;

const posts = (await getCollection("blog"))
  .filter((p) => p.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const slug = CATEGORY_SLUGS[category];
const intro = CATEGORY_INTRO[category] ?? "";

const formatDate = (date: Date) =>
  date.toLocaleDateString("es-MX", { day: "numeric", month: "short", year: "numeric" });

// Breadcrumb JSON-LD: Inicio > Blog > Categoría
const breadcrumb = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog", Astro.site).toString() },
    {
      "@type": "ListItem",
      position: 3,
      name: category,
      item: new URL(`/categorias/${slug}`, Astro.site).toString(),
    },
  ],
});
---

<BaseLayout
  title={`${category} - Blog Aura Gold`}
  description={intro}
>
  <script type="application/ld+json" is:inline set:html={breadcrumb} />

  <Header />

  <main class="bg-ag-black font-body text-white">
    <section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-10">
      <nav class="mb-8 flex items-center gap-2 text-sm text-white/40">
        <a href="/" class="hover:text-white">Inicio</a>
        <span>&gt;</span>
        <a href="/blog" class="hover:text-white">Blog</a>
        <span>&gt;</span>
        <span class="text-white/70">{category}</span>
      </nav>

      <p class="font-mono text-xs uppercase tracking-widest text-ag-gold">Categoría</p>
      <h1 class="mt-2 font-display text-4xl font-semibold lg:text-5xl">{category}</h1>
      <p class="mt-4 max-w-2xl text-white/60">{intro}</p>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post, index) => {
            const author = authors[post.data.author];
            return (
              <a
                href={`/blog/${post.id}`}
                data-animate
                data-delay={index * 70}
                class="group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/5 transition-colors hover:bg-white/10"
              >
                <div class="relative aspect-[16/9] overflow-hidden">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    width="640"
                    height="360"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                  <span class="absolute left-4 top-4 rounded-md bg-ag-black/80 px-3 py-1 font-mono text-xs uppercase tracking-widest text-ag-gold">
                    {post.data.category}
                  </span>
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <h2 class="font-display text-lg text-white">{post.data.title}</h2>
                  <p class="mt-2 line-clamp-3 text-sm text-white/60">{post.data.description}</p>
                  <div class="mt-4 flex items-center gap-2 text-xs text-white/40">
                    <span>{formatDate(post.data.pubDate)}</span>
                    <span>/</span>
                    <span>Por {author?.name}</span>
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>

      <div class="mt-12">
        <a href="/blog" class="text-sm text-ag-gold hover:underline">&larr; Ver todos los artículos</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
