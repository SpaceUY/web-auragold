  <script>
    // Mide el contenido real del iframe de la Bóveda (mismo origen) y lo escala
    // para que entre exacto en su columna, sin scroll interno ni recorte.
    const wrap = document.querySelector<HTMLElement>("[data-boveda-wrap]");
    const frame = document.querySelector<HTMLIFrameElement>("[data-boveda-frame]");

    if (wrap && frame) {
      const fit = () => {
        const doc = frame.contentDocument;
        const body = doc?.body;
        if (!body) return;
        const cw = body.scrollWidth || 1170;
        const ch = body.scrollHeight;
        if (!ch) return; // aún no montó el contenido React
        const scale = wrap.clientWidth / cw;
        frame.style.width = `${cw}px`;
        frame.style.height = `${ch}px`;
        frame.style.transform = `scale(${scale})`;
        wrap.style.height = `${ch * scale}px`;
      };

      // El bundle monta React de forma asíncrona: reintenta durante ~4s.
      let ticks = 0;
      const poll = setInterval(() => {
        fit();
        if (++ticks > 40) clearInterval(poll);
      }, 100);
      frame.addEventListener("load", fit);
      window.addEventListener("resize", fit);
    }
  </script>
