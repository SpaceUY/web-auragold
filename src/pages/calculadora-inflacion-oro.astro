---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import FAQ from "../components/ui/FAQ.astro";
import FAQJsonLD from "../components/seo/FAQJsonLD.astro";
import AppStartLink from "../components/ui/AppStartLink.astro";
import { getCollection } from "astro:content";
import { WEB_APP_URL } from "../data/links";
import {
  INFLATION_RATE_BY_YEAR,
  GOLD_PRICE_MXN_PER_OZ_BY_YEAR,
  START_YEARS,
  LAST_CLOSED_YEAR,
  cumulativeInflationFactor,
} from "../data/gold-inflation-history";

// Snapshot inicial (fallback si falla el fetch en vivo). Mismo criterio que /precio-del-oro-hoy.
const SNAPSHOT_MXN_PER_OZ = 71476;
const DEFAULT_START_YEAR = 2020;
const DEFAULT_AMOUNT = 100000;

const defaultInflationFactor = cumulativeInflationFactor(DEFAULT_START_YEAR);
const defaultGoldValue = (DEFAULT_AMOUNT / GOLD_PRICE_MXN_PER_OZ_BY_YEAR[DEFAULT_START_YEAR]) * SNAPSHOT_MXN_PER_OZ;

// Pilas de billetes vs. lingotes. Muestran dos cosas a la vez:
// - Cuánto dinero es: la pila de efectivo crece con el monto en escala
//   logarítmica (dos fichas por cada cero: $1,000 → 2, $100,000 → 6,
//   $10,000,000 → 10), porque una escala lineal con tope quedaría igual para
//   casi cualquier monto real.
// - Cuánto rindió el oro: su pila es la de efectivo multiplicada por el
//   rendimiento, así la proporción entre las dos es real. Si el oro pasaría de
//   20 fichas, se achican las dos juntas y la proporción se mantiene.
// Con monto 0 no hay fichas. El script de abajo repite este cálculo en el
// navegador (define:vars no permite importar funciones).
// Tope dinámico del oro: se agranda cuando el oro se multiplicó mucho (años
// viejos, p. ej. 2009 ≈ x5.7) para que la pila de billetes pueda llegar a
// PILE_TARGET_BASE y el monto se siga notando. Con más de 21 lingotes (más de
// 6 filas) se dibujan más chicos para entrar en el mismo alto.
const PILE_MIN_CHIPS = 20;
const PILE_MAX_CHIPS = 45;
const PILE_TARGET_BASE = 7;
const PILE_SMALL_FROM = 22;
const PILE_MAX_BASE = 10;
// Tope del campo de monto: por encima de esto los números ya no entran en mobile.
const MAX_AMOUNT = 100_000_000;

function pileLayout(amount: number, purchasingPower: number, goldValue: number) {
  if (amount <= 0) return null;
  const goldMultiple = goldValue / amount;
  const chipCap = Math.min(PILE_MAX_CHIPS, Math.max(PILE_MIN_CHIPS, Math.ceil(PILE_TARGET_BASE * goldMultiple)));
  const maxBase = Math.min(PILE_MAX_BASE, Math.max(1, Math.floor(chipCap / Math.max(goldMultiple, 1))));
  const base = Math.min(maxBase, Math.max(1, Math.round(2 * Math.log10(amount) - 4)));
  const lostChips = Math.min(base, Math.round(base * (1 - purchasingPower / amount)));
  const goldChips = Math.min(chipCap, Math.max(1, Math.round(base * goldMultiple)));
  return { base, lostChips, goldChips };
}

const defaultPurchasingPower = DEFAULT_AMOUNT / defaultInflationFactor;
const defaultPile = pileLayout(DEFAULT_AMOUNT, defaultPurchasingPower, defaultGoldValue)!;
const fmtPesos = (n: number) => `$${Math.round(n).toLocaleString("es-MX")}`;

// Artículos sobre lo mismo que muestra la calculadora, en el orden en que se
// lee el resultado: por qué el oro protege (pila de oro), cuánto perdió el
// peso (billetes grises) y qué le pasa al ahorro en el banco (efectivo).
const RELATED_SLUGS = ["por-que-el-oro-protege-la-inflacion", "evolucion-inflacion-mexico", "oro-fisico-vs-cuentas-bancarias"];
const relatedPosts = (await getCollection("blog"))
  .filter((post) => RELATED_SLUGS.includes(post.id))
  .sort((a, b) => RELATED_SLUGS.indexOf(a.id) - RELATED_SLUGS.indexOf(b.id));


// Billetes: fajo parejo. Lingotes: pirámide, como se apilan en una bóveda.
const billChipBase = "block h-2 w-20 rounded-[2px] border sm:h-3 sm:w-28";
const billChipKept = "border-[#5fae81] bg-[#3f8a5f]";
// Los billetes que perdieron poder de compra se ven apagados: siguen ahí, pero ya no valen lo mismo.
const billChipLost = "border-[#4a505c] bg-[#3a3f4b] opacity-60";
const goldChipClass = "block h-3.5 w-[18px] sm:h-5 sm:w-9";
const goldChipClassSmall = "block h-2.5 w-3 sm:h-3.5 sm:w-6";

// Filas de la pirámide, de abajo hacia arriba: la base es la fila más chica
// que alcanza para todas las fichas y cada fila de arriba tiene una menos.
function pyramidRows(chips: number) {
  let width = 1;
  while ((width * (width + 1)) / 2 < chips) width++;
  const rows: number[] = [];
  let remaining = chips;
  for (let size = width; size > 0 && remaining > 0; size--) {
    rows.push(Math.min(size, remaining));
    remaining -= size;
  }
  return rows;
}

const PAGE_URL = "https://auragold.io/calculadora-inflacion-oro";

const webApplicationJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Calculadora de Inflación de México",
  url: PAGE_URL,
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web",
  inLanguage: "es",
  description:
    "Calculadora que compara, para el año y el monto que elijas, cuánto necesitarías hoy solo para mantener tu poder adquisitivo frente a la inflación en México contra lo que tendrías si lo hubieras convertido en oro.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "MXN",
  },
  publisher: {
    "@type": "Organization",
    name: "Aura Gold",
    url: "https://auragold.io/",
  },
});

// answer: HTML con links reales para el FAQ visual. plainAnswer: mismo texto sin
// tags, para el schema FAQPage (schema.org espera texto plano, no HTML).
const faqItems = [
  {
    question: "¿Cuánto ha subido el oro frente a la inflación en México?",
    answer:
      'Depende del período: desde 2020, la inflación acumulada en México supera el 30% según datos del Banco Mundial e INEGI, mientras que el precio del oro en pesos ha subido considerablemente más, porque combina el alza del metal en dólares con la devaluación del peso frente al dólar. Elige el año que te interesa en la calculadora de arriba, o mira el <a href="/precio-del-oro-hoy" class="text-ag-gold hover:underline">detalle año por año del precio del oro</a>.',
    plainAnswer:
      "Depende del período: desde 2020, la inflación acumulada en México supera el 30% según datos del Banco Mundial e INEGI, mientras que el precio del oro en pesos ha subido considerablemente más, porque combina el alza del metal en dólares con la devaluación del peso frente al dólar. Elige el año que te interesa en la calculadora de arriba para ver el detalle.",
  },
  {
    question: "¿Cuánto vale 1 kg de oro hoy en México?",
    answer:
      'El precio del oro cambia continuamente según el mercado internacional (XAU/USD) y el tipo de cambio MXN/USD. Puedes ver la cotización en vivo, por gramo o por kilo, en la <a href="/precio-del-oro-hoy" class="text-ag-gold hover:underline">página de precio del oro hoy</a>.',
    plainAnswer:
      "El precio del oro cambia continuamente según el mercado internacional (XAU/USD) y el tipo de cambio MXN/USD. Puedes ver la cotización en vivo, por gramo o por kilo, en la página de precio del oro hoy.",
  },
  {
    question: "¿Qué fue la hiperinflación en México?",
    answer:
      'Entre 1985 y 1988, México vivió su peor episodio inflacionario moderno: en 1987 el IPC anual alcanzó 131.8%, destruyendo el poder adquisitivo de millones de familias en meses. Fue el origen de la desconfianza histórica hacia el ahorro en efectivo en el país. Repasamos esta y otras etapas en el <a href="/blog/evolucion-inflacion-mexico" class="text-ag-gold hover:underline">artículo sobre inflación histórica en México</a>.',
    plainAnswer:
      "Entre 1985 y 1988, México vivió su peor episodio inflacionario moderno: en 1987 el IPC anual alcanzó 131.8%, destruyendo el poder adquisitivo de millones de familias en meses. Fue el origen de la desconfianza histórica hacia el ahorro en efectivo en el país. Repasamos esta y otras etapas en el artículo sobre inflación histórica en México.",
  },
  {
    question: "¿Hay una app para invertir en oro en México?",
    answer:
      `Sí. Con Aura Gold puedes convertir tus pesos en oro físico 24k certificado (LBMA), comprando fracciones de gramo y sin comisiones de custodia, con custodia institucional en Suiza y liquidez en 24-48 horas. Conoce <a href="/invertir-en-oro-mexico" class="text-ag-gold hover:underline">cómo invertir en oro en México</a> o <a href="${WEB_APP_URL}" class="text-ag-gold hover:underline">abre tu cuenta</a> para empezar.`,
    plainAnswer:
      "Sí. Con Aura Gold puedes convertir tus pesos en oro físico 24k certificado (LBMA), comprando fracciones de gramo y sin comisiones de custodia, con custodia institucional en Suiza y liquidez en 24-48 horas. Conoce cómo invertir en oro en México o abre tu cuenta para empezar.",
  },
];

const faqJsonLdItems = faqItems.map((item) => ({ question: item.question, answer: item.plainAnswer }));
---

<BaseLayout
  title="Calculadora de Inflación de México vs. Oro"
  description="Elige el año y el monto: compara cuánto necesitarías hoy solo para mantener tu poder adquisitivo frente a la inflación en México, contra lo que tendrías si lo hubieras convertido en oro."
>
  <script type="application/ld+json" is:inline set:html={webApplicationJson} />
  <FAQJsonLD items={faqJsonLdItems} />

  <Header />

  <main class="bg-ag-black font-body text-white">
    <!-- Hero -->
    <section class="mx-auto max-w-[1200px] px-6 pb-4 pt-16 lg:px-10 lg:pt-20">
      <div class="text-center">
        <span class="rounded-full border border-white/20 px-4 py-1 font-body text-xs text-white/70">
          Calculadora
        </span>
        <h1 class="mx-auto mt-6 max-w-3xl font-display text-4xl font-semibold lg:text-6xl">
          Calculadora de <span class="text-ag-gold">Inflación</span> de México
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-white/60">
          Elige el año y el monto. Comparamos qué pasó con un ahorro en pesos sin rendimiento frente a haberlo
          convertido en oro, con datos reales de inflación (Banco Mundial/INEGI) hasta {LAST_CLOSED_YEAR} y el
          precio del oro en vivo para hoy.
        </p>
      </div>
    </section>

    <!-- Calculadora: inflación vs. oro -->
    <section class="mx-auto max-w-[1200px] px-6 py-12 lg:px-10">
      <!-- Calculadora + artículos relacionados: una fila desde 1200px (lg), apilados antes -->
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
        <!--
          Fondo casi negro, igual que la web app y el modal de descarga. La tarjeta
          abraza su contenido (máx. 672px) hasta 1200px; desde ahí comparte la fila con
          los artículos relacionados, así no quedan vacíos a los costados.
        -->
        <div
          class="mx-auto w-full max-w-2xl rounded-3xl border border-white/10 bg-[#101010] px-5 py-8 sm:px-12 sm:py-12 lg:max-w-none"
          data-inflation-calc
        >
          <!-- En mobile, año y monto en una fila (el año angosto). Desde 810px, centrados:
               todo el contenido de la tarjeta comparte un mismo eje central. -->
          <div class="grid grid-cols-[auto_minmax(0,1fr)] items-end gap-3 sm:flex sm:flex-wrap sm:items-end sm:justify-center sm:gap-6">
            <div>
              <label
                for="year-select"
                class="block text-[11px] uppercase leading-4 tracking-[0.1em] text-white/60 sm:text-xs"
                >Año de partida</label
              >
              <div class="mt-2 flex h-11 items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-3 sm:h-[52px] sm:px-4">
                <select
                  id="year-select"
                  data-year-select
                  class="w-full bg-transparent text-base text-white outline-none sm:text-lg"
                >
                  {
                    START_YEARS.map((year) => (
                      <option value={year} selected={year === DEFAULT_START_YEAR}>
                        {year}
                      </option>
                    ))
                  }
                </select>
              </div>
            </div>

            <div>
              <label
                for="amount-input"
                class="block text-[11px] uppercase leading-4 tracking-[0.1em] text-white/60 sm:text-xs"
                ><span class="sm:hidden">Monto (MXN)</span><span class="hidden sm:inline">Monto que tenías (MXN)</span></label
              >
              <div class="mt-2 flex h-11 items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3 sm:h-[52px] sm:gap-3 sm:px-4">
                <span class="shrink-0 text-sm text-white/60">$</span>
                <!-- type="text" + inputmode="numeric": permite mostrar "100,000" y abre el teclado numérico -->
                <input
                  id="amount-input"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  value={DEFAULT_AMOUNT.toLocaleString("es-MX")}
                  data-amount-input
                  aria-describedby="amount-limit"
                  class="w-full min-w-0 bg-transparent text-base text-white outline-none sm:w-40 sm:text-lg"
                />
              </div>
              <p id="amount-limit" class="mt-1.5 hidden text-xs text-white/50" data-amount-limit>
                Monto máximo: {fmtPesos(MAX_AMOUNT)}
              </p>
            </div>

          </div>

          <!-- Pilas centradas lado a lado: fajo de billetes vs. pirámide de lingotes -->
          <div
            class="mt-10 grid grid-cols-2 items-end gap-6 sm:gap-10"
            data-piles
            role="img"
            aria-label={`Guardado en efectivo: ${fmtPesos(DEFAULT_AMOUNT)}, vale ${fmtPesos(defaultPurchasingPower)} hoy ajustado por inflación. Convertido en oro: ${fmtPesos(defaultGoldValue)}.`}
          >
            <div class="flex min-w-0 flex-col items-center text-center">
              <div class="flex flex-col-reverse items-center gap-[3px]" data-pile-cash>
                {
                  Array.from({ length: defaultPile.base }, (_, index) => (
                    <span
                      class={`${billChipBase} ${index >= defaultPile.base - defaultPile.lostChips ? billChipLost : billChipKept}`}
                    />
                  ))
                }
              </div>
              <p class="mt-4 text-xs text-white/60 sm:text-sm">Guardado en efectivo</p>
              <p class="w-full truncate text-base font-semibold text-white sm:text-2xl" data-pile-cash-value>
                {fmtPesos(DEFAULT_AMOUNT)}
              </p>
              <p class="text-xs text-ag-red/90 sm:text-sm" data-pile-cash-note>
                vale {fmtPesos(defaultPurchasingPower)} hoy
              </p>
            </div>

            <div class="flex min-w-0 flex-col items-center text-center">
              <div class="flex flex-col-reverse items-center gap-0.5 sm:gap-[3px]" data-pile-gold>
                {
                  pyramidRows(defaultPile.goldChips).map((rowSize) => (
                    <div class="flex gap-0.5 sm:gap-[3px]">
                      {Array.from({ length: rowSize }, () => (
                        <svg
                          class={defaultPile.goldChips >= PILE_SMALL_FROM ? goldChipClassSmall : goldChipClass}
                          viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                          <polygon points="12,0 88,0 100,100 0,100" fill="#f2b334" />
                          <polygon points="12,0 88,0 82,28 18,28" fill="#ffd36e" />
                        </svg>
                      ))}
                    </div>
                  ))
                }
              </div>
              <p class="mt-4 text-xs text-white/60 sm:text-sm">Convertido en oro</p>
              <p class="w-full truncate text-base font-semibold text-ag-gold sm:text-2xl" data-pile-gold-value>
                {fmtPesos(defaultGoldValue)}
              </p>
              <p class="text-xs text-ag-green sm:text-sm" data-pile-gold-note>
                x{(defaultGoldValue / DEFAULT_AMOUNT).toFixed(1)} tu dinero
              </p>
            </div>
          </div>
          <!-- Solo aparece con monto 0 o vacío -->
          <p class="mt-6 hidden text-center text-sm text-white/70" data-pile-empty>
            Escribe cuánto tenías para ver la comparación.
          </p>

          <!-- Siguiente paso justo después del resultado: Play Store en Android, web app en el resto -->
          <div class="mt-10 flex justify-center">
            <AppStartLink
              medium="calculadora"
              class="inline-flex h-11 items-center justify-center gap-2 rounded-full bg-ag-gold px-6 text-[15px] font-medium text-ag-dark transition-opacity hover:opacity-90 sm:h-12 sm:text-base"
            >
              Empieza a invertir en oro
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </AppStartLink>
          </div>

          <p class="mx-auto mt-6 max-w-xl text-balance text-center text-[11px] leading-snug text-white/50">
            Cálculo ilustrativo: el efectivo se ajusta por la inflación oficial (Banco Mundial, INEGI) hasta{" "}
            {LAST_CLOSED_YEAR} y el oro usa su precio en vivo. No es una proyección ni asesoría financiera. Fuentes:{" "}
            <a href="/blog/evolucion-inflacion-mexico" class="underline decoration-white/40 hover:text-white/80">inflación</a>
            {" · "}
            <a href="/precio-del-oro-hoy" class="underline decoration-white/40 hover:text-white/80">precio del oro</a>.
          </p>
        </div>
        <aside
          class="mx-auto flex w-full max-w-2xl flex-col rounded-3xl border border-white/10 bg-[#101010] px-3 py-6 sm:px-10 sm:py-12 lg:max-w-none lg:px-4"
          aria-labelledby="related-title"
        >
          <h2 id="related-title" class="px-2 font-display text-lg font-semibold text-white">Para entender tu resultado</h2>
          <ul class="mt-4 space-y-3">
            {
              relatedPosts.map((post) => (
                <li>
                  <a
                    href={`/blog/${post.id}`}
                    class="group flex items-center gap-4 rounded-2xl p-2 transition-colors hover:bg-white/5"
                  >
                    <img
                      src={post.data.heroImage}
                      alt=""
                      width="80"
                      height="80"
                      loading="lazy"
                      class="h-20 w-20 shrink-0 rounded-xl object-cover"
                    />
                    <div class="min-w-0">
                      <p class="text-[11px] uppercase tracking-[0.1em] text-ag-gold">{post.data.category}</p>
                      <p class="mt-1 line-clamp-3 text-sm leading-snug text-white group-hover:text-ag-gold">{post.data.title}</p>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
          <!-- mt-auto: en escritorio la tarjeta mide lo mismo que la calculadora y el enlace queda al pie -->
          <a
            href="/blog"
            class="mt-auto inline-flex items-center gap-1 px-2 pt-6 text-sm font-medium text-ag-gold hover:underline"
          >
            Ver todos los artículos
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </aside>
      </div>
    </section>

    <script
      define:vars={{
        SNAPSHOT_MXN_PER_OZ,
        INFLATION_RATE_BY_YEAR,
        GOLD_PRICE_MXN_PER_OZ_BY_YEAR,
        LAST_CLOSED_YEAR,
        PILE_MIN_CHIPS,
        PILE_MAX_CHIPS,
        PILE_TARGET_BASE,
        PILE_SMALL_FROM,
        PILE_MAX_BASE,
        MAX_AMOUNT,
        billChipBase,
        billChipKept,
        billChipLost,
        goldChipClass,
        goldChipClassSmall,
      }}
    >
      // Precio del oro en vivo desde CoinGecko (tether-gold / XAUT ≈ 1 onza troy).
      // Progressive enhancement: si falla el fetch, se usa SNAPSHOT_MXN_PER_OZ.
      let livePricePerOz = SNAPSHOT_MXN_PER_OZ;

      const fmtPesos = (n) => `$${Math.round(n).toLocaleString("es-MX")}`;
      const parseAmount = (text) => Math.max(0, Number(String(text).replace(/\D/g, "")) || 0);

      const cumulativeInflationFactor = (fromYear) => {
        let factor = 1;
        for (let year = fromYear; year <= LAST_CLOSED_YEAR; year++) {
          const rate = INFLATION_RATE_BY_YEAR[year];
          if (rate === undefined) continue;
          factor *= 1 + rate / 100;
        }
        return factor;
      };

      const pileLayout = (amount, purchasingPower, goldValue) => {
        if (amount <= 0) return null;
        const goldMultiple = goldValue / amount;
        const chipCap = Math.min(
          PILE_MAX_CHIPS,
          Math.max(PILE_MIN_CHIPS, Math.ceil(PILE_TARGET_BASE * goldMultiple)),
        );
        const maxBase = Math.min(PILE_MAX_BASE, Math.max(1, Math.floor(chipCap / Math.max(goldMultiple, 1))));
        const base = Math.min(maxBase, Math.max(1, Math.round(2 * Math.log10(amount) - 4)));
        const lostChips = Math.min(base, Math.round(base * (1 - purchasingPower / amount)));
        const goldChips = Math.min(chipCap, Math.max(1, Math.round(base * goldMultiple)));
        return { base, lostChips, goldChips };
      };

      const goldChipSvg = (chipClass) => `<svg class="${chipClass} pile-chip" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><polygon points="12,0 88,0 100,100 0,100" fill="#f2b334"></polygon><polygon points="12,0 88,0 82,28 18,28" fill="#ffd36e"></polygon></svg>`;

      const pyramidRows = (chips) => {
        let width = 1;
        while ((width * (width + 1)) / 2 < chips) width++;
        const rows = [];
        let remaining = chips;
        for (let size = width; size > 0 && remaining > 0; size--) {
          rows.push(Math.min(size, remaining));
          remaining -= size;
        }
        return rows;
      };

      const calc = document.querySelector("[data-inflation-calc]");
      if (calc) {
        const yearSelect = calc.querySelector("[data-year-select]");
        const amountInput = calc.querySelector("[data-amount-input]");
        const amountLimit = calc.querySelector("[data-amount-limit]");
        const piles = calc.querySelector("[data-piles]");
        const cashPile = calc.querySelector("[data-pile-cash]");
        const goldPile = calc.querySelector("[data-pile-gold]");
        const cashValue = calc.querySelector("[data-pile-cash-value]");
        const cashNote = calc.querySelector("[data-pile-cash-note]");
        const goldValueEl = calc.querySelector("[data-pile-gold-value]");
        const goldNote = calc.querySelector("[data-pile-gold-note]");
        const emptyHint = calc.querySelector("[data-pile-empty]");

        // Cada ficha entra con un pequeño retraso respecto de la anterior, así
        // la pila se ve crecer en lugar de aparecer de golpe.
        const staggered = (html, index) => html.replace("pile-chip", `pile-chip" style="animation-delay:${index * 25}ms`);

        const render = () => {
          const startYear = Number(yearSelect.value);
          let amount = parseAmount(amountInput.value);
          const overLimit = amount > MAX_AMOUNT;
          if (overLimit) {
            amount = MAX_AMOUNT;
            amountInput.value = MAX_AMOUNT.toLocaleString("es-MX");
          }
          amountLimit.classList.toggle("hidden", !overLimit);

          const inflationFactor = cumulativeInflationFactor(startYear);
          const purchasingPower = amount / inflationFactor;
          const goldValue = (amount / GOLD_PRICE_MXN_PER_OZ_BY_YEAR[startYear]) * livePricePerOz;
          const goldMultiple = livePricePerOz / GOLD_PRICE_MXN_PER_OZ_BY_YEAR[startYear];
          const layout = pileLayout(amount, purchasingPower, goldValue);

          if (!layout) {
            cashPile.innerHTML = "";
            goldPile.innerHTML = "";
            cashValue.textContent = fmtPesos(0);
            goldValueEl.textContent = fmtPesos(0);
            cashNote.textContent = "";
            goldNote.textContent = "";
            emptyHint.classList.remove("hidden");
            piles.setAttribute("aria-label", "Escribe un monto para ver la comparación entre efectivo y oro.");
            return;
          }

          const { base, lostChips, goldChips } = layout;
          cashPile.innerHTML = Array.from({ length: base }, (_, index) => {
            const state = index >= base - lostChips ? billChipLost : billChipKept;
            return staggered(`<span class="${billChipBase} ${state} pile-chip"></span>`, index);
          }).join("");
          let chipIndex = 0;
          const chipClass = goldChips >= PILE_SMALL_FROM ? goldChipClassSmall : goldChipClass;
          goldPile.innerHTML = pyramidRows(goldChips)
            .map((rowSize) => {
              const row = Array.from({ length: rowSize }, () => staggered(goldChipSvg(chipClass), chipIndex++)).join("");
              return `<div class="flex gap-0.5 sm:gap-[3px]">${row}</div>`;
            })
            .join("");

          cashValue.textContent = fmtPesos(amount);
          cashNote.textContent = `vale ${fmtPesos(purchasingPower)} hoy`;
          emptyHint.classList.add("hidden");
          goldValueEl.textContent = fmtPesos(goldValue);
          goldNote.textContent = `x${goldMultiple.toFixed(1)} tu dinero`;
          piles.setAttribute(
            "aria-label",
            `Guardado en efectivo: ${fmtPesos(amount)}, vale ${fmtPesos(purchasingPower)} hoy ajustado por inflación. Convertido en oro: ${fmtPesos(goldValue)}.`,
          );
        };

        // Separador de miles mientras se escribe ("100,000"), sin mover el cursor:
        // se cuenta cuántos dígitos había antes del cursor y se lo vuelve a ubicar
        // después de la misma cantidad de dígitos en el texto formateado.
        const formatAmountInput = () => {
          const { value, selectionStart } = amountInput;
          const digitsBeforeCursor = value.slice(0, selectionStart ?? value.length).replace(/\D/g, "").length;
          const digits = value.replace(/\D/g, "").replace(/^0+(?=\d)/, "");
          const formatted = digits ? Number(digits).toLocaleString("es-MX") : "";
          amountInput.value = formatted;
          let cursor = 0;
          for (let seen = 0; cursor < formatted.length && seen < digitsBeforeCursor; cursor++) {
            if (/\d/.test(formatted[cursor])) seen++;
          }
          amountInput.setSelectionRange(cursor, cursor);
        };

        yearSelect.addEventListener("change", render);
        amountInput.addEventListener("input", () => {
          formatAmountInput();
          render();
        });
        calc._render = render;
      }

      fetch(
        "https://api.coingecko.com/api/v3/coins/tether-gold?localization=false&tickers=false&market_data=true&community_data=false&developer_data=false&sparkline=false",
      )
        .then((r) => r.json())
        .then((json) => {
          const price = json?.market_data?.current_price?.mxn;
          if (!price) return;
          livePricePerOz = price;
          calc?._render?.();
        })
        .catch((err) => console.error("CoinGecko fetch failed:", err));
    </script>

