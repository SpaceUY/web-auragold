---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import FAQ from "../components/ui/FAQ.astro";
import FinancialDisclaimer from "../components/ui/FinancialDisclaimer.astro";
import AppCTAButtons from "../components/ui/AppCTAButtons.astro";
import FAQJsonLD from "../components/seo/FAQJsonLD.astro";
import AppStartLink from "../components/ui/AppStartLink.astro";

const stats = [
  { value: "24-48h", label: "Liquidez al vender" },
  { value: "0%", label: "Comisión de custodia" },
  { value: "LBMA", label: "Oro certificado" },
  { value: "100%", label: "Oro físico real" },
];

const benefits = [
  {
    title: "5.000 años de historia",
    description:
      'El oro ha sido <a href="/blog/que-es-oro-como-material" class="text-ag-gold hover:underline">reserva de valor en todas las civilizaciones</a>.',
  },
  {
    title: "Oro e inflación",
    description:
      "Cuando el peso pierde poder adquisitivo, el precio del oro en pesos suele subir, aunque no siempre ni al mismo ritmo.",
  },
  {
    title: "Independiente del sistema bancario",
    description:
      "El precio del oro lo fija el mercado internacional, no un banco ni un gobierno.",
  },
  {
    title: "Liquidez cuando la necesitas",
    description:
      "El mercado del oro es uno de los más líquidos del mundo. Puedes convertir tu oro en dinero cuando lo necesites, de forma rápida y transparente.",
  },
  {
    title: "Un activo distinto a las criptomonedas",
    description:
      "El precio del oro también sube y baja, pero responde a factores distintos que el de las criptomonedas. Puede complementar otras formas de ahorro.",
  },
  {
    title: "Tangible y verificable",
    description:
      "El oro existe. No es un número en una pantalla. Es un metal físico, auditable y con precio transparente en mercados globales las 24 horas del día.",
  },
];

const comparisonRows = [
  {
    option: "Aura Gold – Oro físico",
    note: "Barras con estándar LBMA",
    access: "Fácil (fraccionada)",
    highlight: true,
  },
  {
    option: "Cuenta de ahorro bancaria",
    note: "BBVA, Banorte, HSBC…",
    access: "Fácil",
  },
  {
    option: "Criptomonedas (BTC, ETH…)",
    note: "Intercambios digitales",
    access: "Media",
  },
  {
    option: "Oro físico tradicional",
    note: "Joyería, casas de cambio",
    access: "Barrera alta (mínimo alto)",
  },
  {
    option: "Efectivo en casa",
    note: "Colchón bancario",
    access: "Sin fricción",
  },
];

const steps = [
  {
    number: "1",
    title: "Abre tu cuenta en Aura Gold",
    description:
      "Desde la web, sin instalar nada, o desde la app de Android. El proceso de registro es guiado y sin documentación compleja. En menos de 5 minutos tienes tu cuenta activa.",
    tag: "Gratis · Sin comisión de apertura",
  },
  {
    number: "2",
    title: "Deposita el importe que quieras",
    description:
      "Puedes ingresar dinero con transferencia SPEI directamente desde tu banco y comprar la fracción de oro que quieras. Sin sorpresas.",
    tag: "SPEI · Seguro · Instantáneo",
  },
  {
    number: "3",
    title: "Compra tu fracción de oro",
    description:
      "Selecciona el importe en pesos y confirma. Verás exactamente cuántos gramos de oro estás comprando y a qué precio, antes de confirmar. Sin letra pequeña.",
    tag: "Precio transparente · Spread visible",
  },
  {
    number: "4",
    title: "Tu oro queda en tu bóveda",
    description:
      "Tu oro queda custodiado en bóvedas institucionales en Suiza y puedes verificar en cualquier momento qué barras lo respaldan. Puedes venderlo cuando quieras, seguir acumulando o canjearlo por lingotes físicos a través de Tether Gold.",
    tag: "Bóveda certificada · Activo segregado",
  },
];

const securityCards = [
  {
    title: "Oro físico real",
    description:
      "Cada token está respaldado por oro que existe físicamente, en barras acreditadas con estándar LBMA. Y puedes comprobar cuáles.",
  },
  {
    title: "Bóvedas institucionales",
    description:
      "Tu oro se custodia en bóvedas privadas e institucionales con los más altos estándares de seguridad física y legal.",
  },
  {
    title: "Activo segregado",
    description:
      "Tu oro está separado del capital de Aura Gold. Si algo nos pasara, tu oro sigue siendo tuyo y recuperable.",
  },
  {
    title: "Precio transparente",
    description:
      "Mostramos el spread antes de cada operación. Sin comisiones ocultas, sin sorpresas. Sabes cuánto cuesta.",
  },
];

const faqItems = [
  {
    question: "¿Es realmente oro físico o es algo digital como una cripto?",
    answer:
      'Es un token digital respaldado 1:1 por oro físico. Lo digital es cómo se registra y se transfiere; lo físico es lo que le da valor: oro 24k <a href="/blog/glosario-oro#lbma" class="text-ag-gold hover:underline">certificado LBMA</a> en bóvedas en Suiza. Por eso su precio sigue al del oro y no a la especulación cripto. Y si lo quieres en físico, puedes canjear tus tokens por lingotes completos directamente con Tether Gold.',
    plainAnswer:
      "Es un token digital respaldado 1:1 por oro físico. Lo digital es cómo se registra y se transfiere; lo físico es lo que le da valor: oro 24k certificado LBMA en bóvedas en Suiza. Por eso su precio sigue al del oro y no a la especulación cripto. Y si lo quieres en físico, puedes canjear tus tokens por lingotes completos directamente con Tether Gold.",
  },
  {
    question: "¿Cuánto dinero necesito para empezar a invertir en oro en México?",
    answer:
      "Compras fracciones de oro, así que no necesitas pagar una pieza completa para empezar: puedes comenzar con la cantidad que te resulte cómoda para probar el proceso y aumentar gradualmente según tu confianza y capacidad de ahorro. El monto mínimo vigente se muestra en la app antes de confirmar.",
  },
  {
    question: "¿Puedo sacar mi dinero cuando quiera?",
    answer:
      'Sí. La liquidez es inmediata. Puedes vender tu oro en cualquier momento y recibir el equivalente en pesos en tu cuenta. También puedes canjear tus tokens por lingotes de oro físico a través de Tether Gold. Si vendes con ganancia, te explicamos los <a href="/blog/fiscalidad-oro-inversion-mexico" class="text-ag-gold hover:underline">impuestos al invertir en oro</a> en México.',
    plainAnswer:
      "Sí. La liquidez es inmediata. Puedes vender tu oro en cualquier momento y recibir el equivalente en pesos en tu cuenta. También puedes canjear tus tokens por lingotes de oro físico a través de Tether Gold. Si vendes con ganancia, te explicamos los impuestos al invertir en oro en México.",
  },
  {
    question: "¿El oro en Aura Gold tiene comisiones de custodia?",
    answer:
      "No hay comisiones de custodia. El modelo de ingresos de Aura Gold se basa en un spread transparente entre el precio de compra y el de venta del oro, que siempre verás antes de confirmar cualquier operación.",
  },
  {
    question: "¿Qué pasa con mi oro si Aura Gold cierra o quiebra?",
    answer:
      "Tu oro es un activo segregado, lo que significa que está separado del balance de Aura Gold. No forma parte de nuestros activos corporativos. En caso de que Aura Gold cerrara, el oro que compraste sigue siendo tuyo y puede transferirse o recuperarse independientemente.",
  },
  {
    question: "¿Invertir en oro tiene sentido si solo tengo poco dinero para ahorrar?",
    answer:
      "Especialmente entonces. Si el dinero que ahorras está en pesos, pierde poder adquisitivo con la inflación. Convertirlo en oro, aunque sea en pequeñas fracciones, te permite ahorrar en un activo distinto al peso. Ten en cuenta que el precio del oro también puede bajar. Además, la app permite el ahorro recurrente automático para que el hábito sea simple.",
  },
];

// answer admite HTML (links) para el FAQ visual; plainAnswer es el mismo texto sin
// tags para el schema FAQPage. Si un item no tiene plainAnswer, su answer ya es texto plano.
const faqJsonLdItems = faqItems.map((item) => ({
  question: item.question,
  answer: item.plainAnswer ?? item.answer,
}));
---

<BaseLayout
  title="Comprar Oro en México - Cómo Invertir en Oro desde tu Celular"
  description="Cómo invertir en oro en México con Aura Gold: compra oro en fracciones de gramo desde tu celular y conoce los costos y los riesgos antes de empezar."
>
  <FAQJsonLD items={faqJsonLdItems} />

  <Header />

  <main class="bg-ag-black font-body text-white">
    <!-- Hero -->
    <section class="mx-auto max-w-[1200px] px-6 py-20 text-center lg:px-10">
      <span class="rounded-full border border-white/20 px-4 py-1 font-body text-xs text-white/70">
        Oro físico real · México
      </span>
      <h1 class="mx-auto mt-6 max-w-3xl font-display text-4xl font-semibold lg:text-6xl">
        Cómo invertir en <span class="text-ag-gold">oro</span> en México desde tu celular
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-white/60">
        La guía completa para comprar oro físico en México. Con Aura Gold compras oro
        físico fraccionado desde el móvil, con custodia en Suiza y sin comisiones de custodia.
      </p>
      <AppCTAButtons centered class="mt-8" />

      <div class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
        {
          stats.map((stat, i) => (
            <div data-animate data-delay={i * 70} class="rounded-2xl border border-white/10 bg-white/5 p-6">
              <p class="font-display text-3xl text-ag-gold">{stat.value}</p>
              <p class="mt-1 text-sm text-white/50">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Qué significa invertir en oro -->
    <section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-10">
      <SectionHeading eyebrow="Guía básica" title="¿Qué significa invertir en Oro?" align="left" />
      <div class="mt-8 grid gap-10 lg:grid-cols-2">
        <div class="space-y-4 text-white/60">
          <p>
            Invertir en oro significa convertir una parte de tu dinero en un activo físico, cuyo precio sube y baja
            según el mercado internacional.
          </p>
          <p>
            El oro no genera intereses ni dividendos: su valor depende del precio de mercado, que puede subir o
            bajar.
          </p>
          <p>
            Con Aura Gold, cada token que compras está respaldado por oro físico en bóveda. Puedes venderlo
            cuando quieras o, si lo prefieres, canjearlo por lingotes físicos a través de Tether Gold.
          </p>
        </div>
        <div class="space-y-4">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
            <p class="font-display text-white">Oro físico fraccionado</p>
            <p class="mt-2 text-sm text-white/60">Compras una fracción de oro real. Custodiado. A tu nombre.</p>
            <div class="mt-4 grid grid-cols-3 gap-2 text-xs">
              <span class="rounded-lg bg-white/5 px-2 py-2 text-center text-white/60">Fracciones de gramo</span>
              <span class="rounded-lg bg-white/5 px-2 py-2 text-center text-white/60">Oro físico</span>
              <span class="rounded-lg bg-white/5 px-2 py-2 text-center text-white/60">Segregado</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-10">
      <SectionHeading
        eyebrow="Por qué el oro"
        title="Por qué invertir en oro y no en otras alternativas"
        description="Estas son las razones por las que muchas personas en México eligen ahorrar en oro, y lo que conviene saber antes."
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          benefits.map((benefit, i) => (
            <div data-animate data-delay={i * 70} class="rounded-2xl border border-white/10 bg-white/5 p-6">
              <h3 class="font-display text-lg text-white">{benefit.title}</h3>
              <p class="mt-2 text-sm text-white/60" set:html={benefit.description} />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Comparison -->
    <section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-10">
      <SectionHeading
        eyebrow="Comparativa"
        title="Invertir en oro vs otras opciones de ahorro en México"
        description="Antes de decidir dónde poner tu dinero, compara. Oro físico frente a bancos, criptomonedas y efectivo."
      />
      <div class="mt-10 overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-white/10 text-white/50">
              <th class="py-4 pr-4 font-normal">Alternativa</th>
              <th class="py-4 pr-4 font-normal">Accesibilidad</th>
            </tr>
          </thead>
          <tbody>
            {
              comparisonRows.map((row) => (
                <tr class={`border-b border-white/10 ${row.highlight ? "bg-white/5" : ""}`}>
                  <td class="py-4 pr-4">
                    <span class={`font-medium ${row.highlight ? "text-ag-gold" : "text-white"}`}>{row.option}</span>
                    <span class="block text-xs text-white/40">{row.note}</span>
                  </td>
                  <td class="py-4 pr-4 text-white/70">{row.access}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-6 text-sm text-white/50">
        ¿Quieres verlo con tus propios números?{" "}
        <a href="/calculadora-inflacion-oro" class="text-ag-gold hover:underline">
          Calcula cuánto perdiste por inflación en cualquier año
        </a>
        . ¿Y los CETES? Te explicamos aparte{" "}
        <a href="/blog/oro-vs-cetes" class="text-ag-gold hover:underline">cómo se compara el oro con los CETES</a>
        .
      </p>
    </section>

    <!-- Steps -->
    <section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-10">
      <SectionHeading
        eyebrow="Proceso completo"
        title="Cómo comprar oro en México paso a paso desde la App"
        description="Invertir en oro ya no requiere ir a una joyería ni tener grandes capitales. En minutos tu dinero ya está convertido en oro físico real."
      />
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {
          steps.map((step, i) => (
            <div data-animate data-delay={i * 90} class="rounded-2xl border border-white/10 bg-white/5 p-8">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-ag-gold font-display text-lg text-ag-dark">
                {step.number}
              </span>
              <h3 class="mt-4 font-display text-xl text-white">{step.title}</h3>
              <p class="mt-2 text-sm text-white/60">{step.description}</p>
              <p class="mt-4 font-mono text-xs uppercase tracking-widest text-ag-gold">{step.tag}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Security -->
    <section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-10">
      <SectionHeading
        eyebrow="Seguridad y transparencia"
        title="Cómo funciona la seguridad en Aura Gold"
        description="Invertir en oro exige pruebas, no solo promesas. Esto es lo que hay detrás de cada compra."
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          securityCards.map((card, i) => (
            <div data-animate data-delay={i * 70} class="rounded-2xl border border-white/10 bg-white/5 p-6">
              <h3 class="font-display text-lg text-white">{card.title}</h3>
              <p class="mt-2 text-sm text-white/60">{card.description}</p>
            </div>
          ))
        }
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-white/50">
        <strong class="text-white">¿Qué pasa si Aura Gold cierra?</strong> Al ser un activo segregado, tu oro
        permanece bajo tu titularidad y puede transferirse o recuperarse. Puedes
        comprobar{" "}
        <a href="/transparencia" class="text-ag-gold hover:underline">la custodia en Suiza, los informes de reservas y el spread</a>{" "}
        en la página de transparencia. Y si quieres el panorama completo, te explicamos los{" "}
        <a href="/blog/es-seguro-invertir-en-oro" class="text-ag-gold hover:underline">riesgos reales de invertir en oro</a>{" "}
        y cómo evitarlos.
      </p>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-10">
      <SectionHeading
        eyebrow="FAQs"
        title="Preguntas Frecuentes"
        description="Sin rodeos y sin jerga financiera. Todo lo que necesitas saber antes de empezar."
      />
      <div class="mt-12">
        <FAQ items={faqItems} />
      </div>
      <FinancialDisclaimer class="mx-auto mt-8 max-w-3xl text-center" />
    </section>

    <!-- Final CTA -->
    <section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-10">
      <div data-animate class="rounded-3xl bg-gradient-to-br from-ag-navy to-ag-dark-2 px-6 py-10 text-center sm:p-10 lg:p-16">
        <h2 class="font-display text-3xl font-semibold text-white lg:text-4xl">
          Convierte tus pesos en oro hoy, al precio del mercado
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-white/60">
          Oro físico fraccionado al precio más cercano al spot XAU/MXN, sin comisiones de custodia.
          Abre tu cuenta desde la app o la web y empieza en minutos.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <AppStartLink
            medium="cta-final-invertir"
            class="inline-flex items-center justify-center rounded-full bg-ag-gold px-6 py-3 font-medium text-ag-dark hover:opacity-90"
          >
            Abrir mi bóveda
          </AppStartLink>
          <a
            href="/#como-funciona"
            class="inline-flex items-center justify-center rounded-full border border-white/20 px-6 py-3 font-medium text-white hover:bg-white/10"
          >
            Ver cómo funciona
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
