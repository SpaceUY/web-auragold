---
// Modal de "Descargar app" para escritorio: un QR por tienda (Play Store y
// App Store) para escanear con el celular. Usa <dialog> nativo: showModal()
// ya resuelve el foco, la tecla Esc y que el resto de la página no sea
// interactivo. En Android y iPhone los botones van directo a su tienda y este
// modal no se abre.
//
// Los QR se generan en el build como SVG: no agregan JavaScript al sitio.
import QRCode from "qrcode";
import { IOS_APP_URL, playStoreUrl, WEB_APP_URL } from "../../data/links";

const qrOptions = { type: "svg", margin: 0, color: { dark: "#090909", light: "#ffffff" } } as const;
const stores = [
  { label: "Android", qrSvg: await QRCode.toString(playStoreUrl("qr-modal"), qrOptions) },
  { label: "iPhone", qrSvg: await QRCode.toString(IOS_APP_URL, qrOptions) },
];
---

<dialog
  data-app-download-dialog
  aria-labelledby="app-download-title"
  class="app-download-dialog m-auto w-[calc(100%-3rem)] max-w-[22rem] overflow-visible bg-transparent p-0 text-white backdrop:bg-ag-black/70 backdrop:backdrop-blur-md"
>
  <div
    class="relative overflow-hidden rounded-3xl border border-white/10 bg-[#101010] px-5 pb-5 pt-7 text-center shadow-[0_24px_60px_-16px_rgba(0,0,0,0.8)]"
  >
    <div class="pointer-events-none absolute -top-20 left-1/2 h-40 w-40 -translate-x-1/2 rounded-full bg-ag-gold/15 blur-3xl"></div>

    <button
      type="button"
      data-dialog-close
      aria-label="Cerrar"
      class="absolute right-3 top-3 z-10 flex h-7 w-7 items-center justify-center rounded-full bg-white/10 text-white/70 transition-colors hover:bg-white/20 hover:text-white"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
      </svg>
    </button>

    <div class="relative">
      <h2 id="app-download-title" class="text-balance px-6 font-display text-lg font-semibold leading-snug">
        Descarga Aura en tu celular
      </h2>
      <p class="mt-1.5 text-[13px] text-white/60">Escanea el código con la cámara de tu celular.</p>
      <div class="mt-5 grid grid-cols-2 gap-3">
        {
          stores.map((store) => (
            <figure class="flex flex-col items-center gap-2">
              <div class="w-full rounded-2xl bg-white p-2.5" set:html={store.qrSvg} />
              <figcaption class="text-[13px] font-medium text-white/80">{store.label}</figcaption>
            </figure>
          ))
        }
      </div>
      <!-- El {" "} es necesario: el build borra el salto de línea entre el texto y el enlace -->
      <p class="mt-5 text-[13px] text-white/50">
        ¿Prefieres no instalar nada?{" "}
        <a href={WEB_APP_URL} data-cta="webapp-desktop-modal" data-cta-position="modal" class="text-ag-gold hover:underline">Usa Aura desde la web</a>
      </p>
    </div>
  </div>
</dialog>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .app-download-dialog[open] {
      animation: app-download-in 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .app-download-dialog[open]::backdrop {
      animation: app-download-fade 0.35s ease-out;
    }

    @keyframes app-download-in {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.96);
      }
    }

    @keyframes app-download-fade {
      from {
        opacity: 0;
      }
    }
  }
</style>

<script>
  import { detectPlatform } from "../../lib/platform";

  const dialog = document.querySelector<HTMLDialogElement>("[data-app-download-dialog]");

  if (dialog && detectPlatform() === "desktop") {
    const close = () => dialog.close();

    document.querySelectorAll<HTMLAnchorElement>("[data-app-download-link]").forEach((link) => {
      link.setAttribute("aria-haspopup", "dialog");
      link.addEventListener("click", (event) => {
        event.preventDefault();
        dialog.showModal();
        // La página de atrás no se desplaza mientras el modal está abierto.
        document.documentElement.classList.add("overflow-hidden");
      });
    });

    dialog.addEventListener("close", () => document.documentElement.classList.remove("overflow-hidden"));
    dialog.querySelectorAll("[data-dialog-close]").forEach((button) => button.addEventListener("click", close));
    // Tocar afuera de la tarjeta (sobre el fondo desenfocado) también cierra.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });
  }
</script>
