---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<div class="mx-auto max-w-3xl divide-y divide-white/10">
  {
    items.map((item, index) => (
      <details class="group py-5" open={index === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg text-white">
          {item.question}
          <span class="shrink-0 text-ag-gold transition-transform group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 font-body text-sm leading-relaxed text-white/60">{item.answer}</p>
      </details>
    ))
  }
</div>
