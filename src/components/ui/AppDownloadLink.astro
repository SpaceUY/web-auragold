---
// Botón "Descargar app" que resuelve el destino según el dispositivo:
// - Android: ficha de Play Store (el href por defecto, funciona sin JS).
// - iPhone/iPad: todavía no hay app nativa. Abre el modal de AppDownloadDialog
//   con el aviso "llega pronto" y un botón a la web app.
// - Escritorio: abre el mismo modal con un QR para escanear con el celular.
// El modal se renderiza una sola vez (en el Header) y lo comparten todos los botones.
import { playStoreUrl } from "../../data/links";

interface Props {
  medium: string;
  class?: string;
}

const { medium, class: className = "" } = Astro.props;
---

<a href={playStoreUrl(medium)} data-app-download-link data-cta={`download-${medium}`} class={className}>
  Descargar app
</a>
