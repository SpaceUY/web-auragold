---
// Par de CTAs del hero. Vive en un componente porque se repite en el home y en
// /invertir-en-oro-mexico, y los paths de los iconos no deben duplicarse.
//
// La web app es el CTA principal porque funciona en cualquier dispositivo
// (incluido iPhone, donde la app nativa todavía no está). Se abre en la misma
// pestaña: es el paso siguiente del flujo, no una referencia externa. La ficha
// de Play Store queda como secundaria y sí abre aparte.
//
// data-cta identifica la ubicación del click para medirlo desde GTM.
import { ANDROID_APP_URL, WEB_APP_URL } from "../../data/links";

interface Props {
  id?: string;
  class?: string;
  style?: string;
  centered?: boolean;
  ctaLocation?: string;
}

const { id, class: className = "", style, centered = false, ctaLocation = "hero" } = Astro.props;
const alignment = centered ? "items-center" : "items-center lg:items-start";
---

<div id={id} class={`flex flex-col gap-3 ${alignment} ${className}`} style={style}>
  <div class="flex w-full flex-col gap-4 sm:w-auto sm:flex-row sm:flex-wrap">
    <a
      href={WEB_APP_URL}
      data-cta={`webapp-${ctaLocation}`}
      class="group inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full bg-ag-gold px-6 py-3 font-medium text-ag-dark transition-opacity hover:opacity-90"
    >
      Empieza ahora
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-[18px] w-[18px] transition-transform group-hover:translate-x-0.5"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
    <a
      href={ANDROID_APP_URL}
      target="_blank"
      rel="noopener noreferrer"
      data-cta={`android-${ctaLocation}`}
      class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full border border-white/20 px-6 py-3 font-medium text-white transition-colors hover:bg-white/10"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-[18px] w-[18px]" aria-hidden="true" focusable="false">
        <path
          d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993.0001.5511-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.2439 13.8533 7.8508 12 7.8508s-3.5902.3931-5.1367 1.0989L4.841 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3435-4.1021-2.6892-7.5743-6.0775-9.4396"
        ></path>
      </svg>
      Descargar para Android
    </a>
  </div>
  <p class="text-balance text-sm text-white/40">En la web y en Android. iOS muy pronto.</p>
</div>
