---
// Par de CTAs del hero. Vive en un componente porque se repite en el home y en
// /invertir-en-oro-mexico, y los paths de los iconos no deben duplicarse.
//
// La web app es el CTA principal porque funciona en cualquier dispositivo y
// sin instalar nada. Se abre en la misma pestaña: es el paso siguiente del
// flujo, no una referencia externa. Las fichas de Play Store y del App Store
// quedan como secundarias y sí abren aparte.
//
// data-cta (cta_id) y data-cta-position (cta_position) los lee CtaTracking (WEB-001).
import { ANDROID_APP_URL, IOS_APP_URL, WEB_APP_URL } from "../../data/links";
import RiskWarning from "./RiskWarning.astro";

interface Props {
  id?: string;
  class?: string;
  style?: string;
  centered?: boolean;
  ctaLocation?: string;
}

const { id, class: className = "", style, centered = false, ctaLocation = "hero" } = Astro.props;
const alignment = centered ? "items-center" : "items-center lg:items-start";
const textAlignment = centered ? "text-center" : "text-center lg:text-left";
const justify = centered ? "justify-center" : "justify-center lg:justify-start";
const storeButtonClass =
  "inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border border-white/20 px-3.5 py-1.5 text-sm font-medium text-white transition-colors hover:bg-white/10";
---

<div id={id} class={`flex flex-col gap-3 ${alignment} ${className}`} style={style}>
  <div class={`flex w-full flex-col gap-4 ${alignment}`}>
    <a
      href={WEB_APP_URL}
      data-cta={`webapp-${ctaLocation}`}
      data-cta-position={ctaLocation}
      class="group inline-flex items-center self-stretch sm:self-auto justify-center gap-2 whitespace-nowrap rounded-full bg-ag-gold px-6 py-3 font-medium text-ag-dark transition-opacity hover:opacity-90"
    >
      Empieza ahora
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-[18px] w-[18px] transition-transform group-hover:translate-x-0.5"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
    <!-- Las tiendas van debajo del CTA principal, más chicas: son la alternativa a la web.
         En celular el texto va en su línea para que las dos tiendas no se separen.
         "Descargar para" queda para los lectores de pantalla. -->
    <div class={`flex flex-wrap items-center gap-2.5 ${justify}`}>
      <span class="basis-full text-center text-sm text-white/55 sm:basis-auto">o descarga la app:</span>
      <a
        href={ANDROID_APP_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-cta={`android-${ctaLocation}`}
        data-cta-position={ctaLocation}
        class={storeButtonClass}
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true" focusable="false">
          <path
            d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993.0001.5511-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.2439 13.8533 7.8508 12 7.8508s-3.5902.3931-5.1367 1.0989L4.841 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3435-4.1021-2.6892-7.5743-6.0775-9.4396"
          ></path>
        </svg>
        <span><span class="sr-only">Descargar para </span>Android</span>
      </a>
      <a
        href={IOS_APP_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-cta={`ios-${ctaLocation}`}
        data-cta-position={ctaLocation}
        class={storeButtonClass}
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true" focusable="false">
          <path
            d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
          ></path>
        </svg>
        <span><span class="sr-only">Descargar para </span>iPhone</span>
      </a>
    </div>
  </div>
  <RiskWarning class={`max-w-md ${textAlignment}`} />
</div>
