---
import { ANDROID_APP_URL, IOS_APP_URL } from "../../data/links";
import { LEGAL_ENTITY } from "../../data/legal";

const graph = [
  {
    "@type": "Organization",
    "@id": "https://auragold.io/#organization",
    name: "Aura Gold",
    // Variantes históricas: no son copy visible, sirven para que los motores
    // resuelvan la misma entidad cuando el usuario busca "Aura" o "AuraGold".
    alternateName: ["Aura", "AuraGold"],
    url: "https://auragold.io/",
    legalName: LEGAL_ENTITY.name,
    email: LEGAL_ENTITY.legalEmail,
    description:
      "Plataforma para comprar oro físico 24k desde una app móvil, en fracciones de gramo, con custodia internacional y liquidez.",
    address: {
      "@type": "PostalAddress",
      streetAddress: LEGAL_ENTITY.address,
      addressCountry: LEGAL_ENTITY.countryCode,
    },
    logo: {
      "@type": "ImageObject",
      url: "https://auragold.io/images/logo/favicon.png",
      width: 456,
      height: 456,
    },
    founder: { "@id": "https://auragold.io/autores/federico-sendra#person" },
    // Fichas verificadas de la app (únicas presencias de terceros confirmadas hoy).
    // Sumar acá LinkedIn/Instagram de la empresa apenas existan esos perfiles reales.
    sameAs: [ANDROID_APP_URL, IOS_APP_URL],
  },
  {
    "@type": "WebSite",
    "@id": "https://auragold.io/#website",
    url: "https://auragold.io/",
    name: "Aura Gold",
    publisher: { "@id": "https://auragold.io/#organization" },
    inLanguage: "es",
  },
  {
    "@type": "WebPage",
    "@id": "https://auragold.io/#webpage",
    url: "https://auragold.io/",
    name: "Aura Gold | Compra e invierte en oro desde nuestra App",
    isPartOf: { "@id": "https://auragold.io/#website" },
    about: { "@id": "https://auragold.io/#app" },
    description:
      "Compra e invierte en oro físico 24k en fracciones de gramo, con custodia internacional, liquidez y acceso desde la app.",
    inLanguage: "es",
  },
  {
    "@type": "SoftwareApplication",
    "@id": "https://auragold.io/#app",
    name: "Aura Gold",
    alternateName: ["Aura", "AuraGold"],
    url: "https://auragold.io/",
    applicationCategory: "FinanceApplication",
    operatingSystem: "Android, iOS, Web",
    availableLanguage: "es",
    publisher: { "@id": "https://auragold.io/#organization" },
    description:
      "Aplicación para Android, iPhone y web para comprar, guardar y vender oro físico 24k en fracciones de gramo, con custodia institucional internacional y opción de canje por lingotes de oro físico.",
    featureList: [
      "Compra de oro en fracciones de gramo",
      "Oro físico 24k",
      "Oro de Tether Gold (XAUT) en barras con estándar Good Delivery de la LBMA",
      "Custodia internacional en Suiza",
      "Venta de oro desde la app y retiro a tu cuenta bancaria",
      "Canje por lingotes de oro físico",
      "Ahorro programado",
      "Organización del ahorro por objetivos",
    ],
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "MXN",
      description: "Sin costos de apertura",
    },
  },
];

const json = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });
---

<script type="application/ld+json" is:inline set:html={json} />
