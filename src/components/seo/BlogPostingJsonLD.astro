---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  updatedDate?: Date;
  authorSlug: string;
  authorName: string;
  categoryLabel: string;
  categorySlug: string;
  heroImage: string;
  video?: { youtubeId: string; title: string; description: string; uploadDate: Date; duration: string };
}

const {
  title,
  description,
  slug,
  pubDate,
  updatedDate,
  authorSlug,
  authorName,
  categoryLabel,
  categorySlug,
  heroImage,
  video,
} = Astro.props;
const url = new URL(`/blog/${slug}`, Astro.site).toString();
const authorUrl = new URL(`/autores/${authorSlug}`, Astro.site).toString();
const imageUrl = new URL(heroImage, Astro.site).toString();

// VideoObject: lo que Google pide para mostrar el video en los resultados (nombre, descripción,
// miniatura y fecha de subida), más la duración y las URL del reproductor y de YouTube.
const videoObject = video && {
  "@type": "VideoObject",
  name: video.title,
  description: video.description,
  thumbnailUrl: [`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`],
  uploadDate: video.uploadDate.toISOString(),
  duration: video.duration,
  embedUrl: `https://www.youtube-nocookie.com/embed/${video.youtubeId}`,
  url: `https://www.youtube.com/watch?v=${video.youtubeId}`,
  publisher: { "@id": "https://auragold.io/#organization" },
};

const json = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).toString() },
        {
          "@type": "ListItem",
          position: 2,
          name: categoryLabel,
          item: new URL(`/categorias/${categorySlug}`, Astro.site).toString(),
        },
        { "@type": "ListItem", position: 3, name: title, item: url },
      ],
    },
    {
      "@type": "BlogPosting",
      headline: title,
      description,
      url,
      mainEntityOfPage: { "@id": url },
      image: imageUrl,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate ?? pubDate).toISOString(),
      author: { "@id": `${authorUrl}#person`, "@type": "Person", name: authorName, url: authorUrl },
      publisher: { "@id": "https://auragold.io/#organization", "@type": "Organization", name: "Aura Gold" },
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: ["h1", "article p"],
      },
      ...(videoObject ? { video: videoObject } : {}),
    },
  ],
});
---

<script type="application/ld+json" is:inline set:html={json} />
