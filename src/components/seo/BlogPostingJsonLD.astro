---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  updatedDate?: Date;
  authorSlug: string;
  authorName: string;
  categoryLabel: string;
  categorySlug: string;
  heroImage: string;
}

const {
  title,
  description,
  slug,
  pubDate,
  updatedDate,
  authorSlug,
  authorName,
  categoryLabel,
  categorySlug,
  heroImage,
} = Astro.props;
const url = new URL(`/blog/${slug}`, Astro.site).toString();
const authorUrl = new URL(`/autores/${authorSlug}`, Astro.site).toString();
const imageUrl = new URL(heroImage, Astro.site).toString();

const json = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).toString() },
        {
          "@type": "ListItem",
          position: 2,
          name: categoryLabel,
          item: new URL(`/categorias/${categorySlug}`, Astro.site).toString(),
        },
        { "@type": "ListItem", position: 3, name: title, item: url },
      ],
    },
    {
      "@type": "BlogPosting",
      headline: title,
      description,
      url,
      mainEntityOfPage: { "@id": url },
      image: imageUrl,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate ?? pubDate).toISOString(),
      author: { "@id": `${authorUrl}#person`, "@type": "Person", name: authorName, url: authorUrl },
      publisher: { "@id": "https://auragold.io/#organization", "@type": "Organization", name: "Aura Gold" },
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: ["h1", "article p"],
      },
    },
  ],
});
---

<script type="application/ld+json" is:inline set:html={json} />
