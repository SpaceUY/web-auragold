# API key de Brevo (Transactional Email), usada por /api/contact.js para
# enviar el formulario de soporte de /politicas-de-privacidad.
# Configurar en Vercel: Project Settings -> Environment Variables.
# Nunca completar este valor acá ni commitear la key real.
BREVO_API_KEY=

# Client ID público de OpenPanel para Aura (WEB-012A). Es público por diseño:
# viaja en el JavaScript del sitio. Configurar en Vercel (Production y Preview).
# El CLIENT_SECRET de OpenPanel NO va acá ni en la landing: es solo para un servidor.
PUBLIC_OPENPANEL_CLIENT_ID=
